<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sed-mcp</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pin the stable SDK line supporting initialize-based MCP clients. -->
    <PackageReference Include="ModelContextProtocol.Core" Version="1.4.1" />
    <ProjectReference Include="../../src/Sed.Formats/Sed.Formats.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../../data/master.tpl" Link="data/master.tpl" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../data/mots.tpl" Link="data/mots.tpl" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
