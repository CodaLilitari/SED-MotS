<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sed.Rendering\Sed.Rendering.csproj" />
    <ProjectReference Include="..\Sed.Core\Sed.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Shaders\*.spv" />
  </ItemGroup>

  <!-- GLSL and SPIR-V are a checked pair. Run tools/Compile-Shaders.ps1 after
       shader edits; builds without a compiler still reject stale binaries. -->
  <Import Project="Shaders/ShaderHashes.props" />
  <Target Name="VerifyCommittedShaders" BeforeTargets="BeforeBuild">
    <GetFileHash Files="@(VerifiedShader)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="ShaderWithHash" />
    </GetFileHash>
    <Error Condition="'%(ShaderWithHash.FileHash)' != '%(ShaderWithHash.ExpectedHash)'"
           Text="Shader source/binary hash mismatch: %(ShaderWithHash.Identity). Run tools/Compile-Shaders.ps1 with glslangValidator and spirv-val, then review all shader outputs." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Core" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
